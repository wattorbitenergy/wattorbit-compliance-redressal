# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wattorbit?retryWrites=true&w=majority

# Security
JWT_SECRET=your_jwt_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_EMAIL=admin@wattorbit.in


# Email Configuration (Titan SMTP)
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=support@wattorbit.in
SMTP_PASS=your_titan_email_password_here
SMTP_FROM="WattOrbit Support <support@wattorbit.in>"

# SMS Configuration (Fast2SMS - DLT)
# Get your API key from https://www.fast2sms.com → Developer → API
FAST2SMS_API_KEY=your_fast2sms_api_key_here
# Sender IDs (must be registered in DLT portal)
# WTORBT = OTP messages, WATORB = Service update messages
FAST2SMS_OTP_TEMPLATE_ID=your_numeric_otp_template_id
FAST2SMS_ASSIGNED_TEMPLATE_ID=your_numeric_assigned_template_id
FAST2SMS_COMPLETED_TEMPLATE_ID=your_numeric_completed_template_id
FAST2SMS_BOOKING_CREATED_TEMPLATE_ID=your_numeric_booking_created_id
FAST2SMS_JOB_ASSIGNED_TEMPLATE_ID=your_numeric_job_assigned_id
FAST2SMS_SERVICE_OTP_TEMPLATE_ID=your_numeric_employee_creation_otp_id
WHATSAPP_ADMIN_NUMBER=your_admin_number

# Payment Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
CENTRAL_UPI_ID=wattorbit@bank
CENTRAL_UPI_NAME=WattOrbit Energy
ADDITIONAL_SERVICE_DISCOUNT=10

# Cloudinary Configuration
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Push Notifications (Firebase)
# You can either provide the JSON string here or put serviceAccountKey.json in the root
# FIREBASE_SERVICE_ACCOUNT={"type": "service_account", ...}
